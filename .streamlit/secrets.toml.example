# Copy this file to .streamlit/secrets.toml for local development.
# .streamlit/secrets.toml is gitignored - never commit real secrets.
# On Streamlit Community Cloud, set these under App settings -> Secrets instead.

APP_PASSWORD = "changeme"

# Optional. Fine-grained GitHub token for THIS repo only, "Contents: Read and write", with an
# expiry. Lets the app save pins (and future user data) to the `user-data` branch. Without it
# the app runs read-only and the pin controls are hidden.
# GITHUB_USERDATA_TOKEN = "github_pat_..."
